# Copy to .env (deploy/setup_install.py does this for you and fills in random keys).
# NEVER share or commit the real .env.

DEBUG=False
DJANGO_SECRET_KEY=generate-with-setup_install.py
DJANGO_SALT_KEY=generate-with-setup_install.py

# Comma separated names/IPs people type in the browser. Empty = localhost + this computer's name and LAN IP.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Set HTTPS=true only when the site is really served over https (cookies then become secure-only).
HTTPS=false
# true only when nginx/Caddy/IIS in front of the app sets X-Forwarded-Proto.
BEHIND_PROXY=false

# Media files (logo, documents): local = on this computer (default, works offline).
MEDIA_STORAGE=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Backup failure e-mails / password reset (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Development only (Termux): RUNNING_IN_TERMUX=true  and  DEBUG=True
